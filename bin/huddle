#!/usr/bin/env node
// Huddle: one CLI. labels | wait | take | pending | progress | team | hook | doctor. See lib/cli/run.mjs.
import { endProcess, main } from '../lib/cli/main.mjs';

const argv = process.argv.slice(2);
const code = await main(argv);
process.exitCode = code;
endProcess(argv, code); // the hook does not wait for a child process that is still running
